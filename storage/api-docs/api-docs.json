{
    "openapi": "3.0.0",
    "info": {
        "title": "API Painting Recognition",
        "description": "API allows users to upload an image of a painting for prediction using an external Flask API.",
        "version": "1.0.0"
    },
    "paths": {
        "/api/predict": {
            "post": {
                "tags": [
                    "Paintings"
                ],
                "summary": "Predict a painting using a Flask API",
                "description": "Upload an image of a painting to be predicted and store the result in the database.",
                "operationId": "4f9415e4c3b72bd3f283823d92eabd79",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "properties": {
                                    "image": {
                                        "description": "The image file to be predicted",
                                        "type": "string",
                                        "format": "binary"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Successful prediction"
                    },
                    "400": {
                        "description": "Invalid image file provided"
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "Paintings",
            "description": "Paintings"
        }
    ]
}